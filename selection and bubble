#include <iostream>
using namespace std;

void selectionSort(float a[], int n)
{
    int comparisons = 0;

    for(int i = 0; i < n - 1; i++)
    {
        int min = i;

        for(int j = i + 1; j < n; j++)
        {
            comparisons++;

            if(a[j] < a[min])
                min = j;
        }

        float temp = a[i];
        a[i] = a[min];
        a[min] = temp;
    }

    cout << "\nSelection Sort (Ascending Order):\n";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";

    cout << "\nTop 5 Scores:\n";
    for(int i = n - 1; i >= n - 5 && i >= 0; i--)
        cout << a[i] << " ";

    cout << "\nTotal Comparisons = " << comparisons << endl;
}

void bubbleSort(float a[], int n)
{
    int comparisons = 0;

    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            comparisons++;

            if(a[j] > a[j + 1])
            {
                float temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }

    cout << "\nBubble Sort (Ascending Order):\n";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";

    cout << "\nTop 5 Scores:\n";
    for(int i = n - 1; i >= n - 5 && i >= 0; i--)
        cout << a[i] << " ";

    cout << "\nTotal Comparisons = " << comparisons << endl;
}

int main()
{
    int n, choice;
    float a[100], b[100];

    cout << "Enter number of students: ";
    cin >> n;

    cout << "Enter percentages:\n";
    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
        b[i] = a[i];
    }

    cout << "\n1. Selection Sort";
    cout << "\n2. Bubble Sort";
    cout << "\nEnter your choice: ";
    cin >> choice;

    switch(choice)
    {
        case 1:
            selectionSort(a, n);
            break;

        case 2:
            bubbleSort(b, n);
            break;

        default:
            cout << "Invalid Choice!";
    }

    return 0;
}
