#include <iostream>
using namespace std;

struct Node
{
    int order;
    Node *next;
};

Node *front = NULL, *rear = NULL;

int count = 0;
int M;

void addOrder()
{
    if (count == M)
    {
        cout << "Queue is full!\n";
        return;
    }

    Node *newNode = new Node;

    cout << "Enter Order: ";
    cin >> newNode->order;

    newNode->next = NULL;

    if (front == NULL)
    {
        front = rear = newNode;
    }
    else
    {
        rear->next = newNode;
        rear = newNode;
    }

    count++;

    cout << "Order added successfully!\n";
}

void deleteOrder()
{
    if (front == NULL)
    {
        cout << "Queue is Empty!\n";
        return;
    }

    Node *temp = front;

    cout << "Deleted Order: " << temp->order << endl;

    front = front->next;

    delete temp;

    count--;

    if (front == NULL)
        rear = NULL;
}

void display()
{
    Node *temp = front;

    if (front == NULL)
    {
        cout << "Queue is Empty!\n";
        return;
    }

    cout << "Orders in Queue: ";

    while (temp != NULL)
    {
        cout << temp->order << " ";
        temp = temp->next;
    }

    cout << endl;
}

int main()
{
    cout << "Name : Shete Asmita Bhaskar\n";
    cout << "Roll No : 240\n";

    int choice, n;
     cout <<"Enter maximum number of order(M):";
     cin >> M;
    do
    {
        cout << "\n1. Add Order";
        cout << "\n2. Delete Order";
        cout << "\n3. Display Order";
        cout << "\n4. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        if (choice == 1)
        {
            cout << "How many orders: ";
            cin >> n;

            for (int i = 0; i < n; i++)
                addOrder();
        }
        else if (choice == 2)
        {
            deleteOrder();
        }
        else if (choice == 3)
        {
            display();
        }
        else if (choice == 4)
        {
            cout << "Exiting...\n";
        }
        else
        {
            cout << "Invalid choice!\n";
        }

    } while (choice != 4);

    return 0;
}
